{
	"name": "snap-solana",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "sh ./build_snap.sh",
				"cwd": "snap-solana"
			},
			"outputs": [
				"{workspaceRoot}/dist"
			]
		},
		"link": {
			"executor": "nx:run-commands",
			"options": {
				"command": "cd snap-wallet-adapter && bun link",
				"cwd": "snap-solana"
			},
			"dependsOn": [
				"build"
			]
		}
	}
}